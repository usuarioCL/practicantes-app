<!-- views/practicantes/index.ejs -->
<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <title>Lista de Practicantes</title>
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>

  <div class="container-fluid">
    <div class="row">

      <!-- Sidebar (todo el alto) -->
      <div class="col-12 col-md-2 col-lg-1 p-0">
        <%- include('../partials/sidebar') %>
      </div>

      <!-- Contenido principal -->
      <main class="col-12 col-md-9 col-lg-10 p-4">
        <h2 class="mb-4">Lista de Practicantes</h2>
        <a href="/practicantes/crear" class="btn btn-success mb-3">Agregar Practicante</a>

        <table class="table table-bordered table-striped">
          <thead class="table-light">
            <tr>
              <th>#</th>
              <th>Nombre</th>
              <th>Correo</th>
              <th>Carrera</th>
              <th>Acciones</th>
            </tr>
          </thead>
          <tbody>
            <% practicantes.forEach(practicante => { %>
              <tr>
                <td><%= practicante.id %></td>
                <td><%= practicante.nombre_completo %></td>
                <td><%= practicante.correo %></td>
                <td><%= practicante.carrera_nombre %></td>
                <td>
                  <a href="/practicantes/<%= practicante.id %>" class="btn btn-info btn-sm">Ver</a>
                  <a href="/practicantes/<%= practicante.id %>/editar" class="btn btn-warning btn-sm">Editar</a>
                  <form action="/practicantes/<%= practicante.id %>/eliminar" method="POST" class="d-inline">
                    <button type="submit" class="btn btn-danger btn-sm">Eliminar</button>
                  </form>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>

      </main>

    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
