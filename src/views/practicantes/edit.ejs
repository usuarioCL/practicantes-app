<%- include('../partials/header') %>

<div class="container py-4">
  <div class="card shadow-sm rounded-4">
    <div class="card-header bg-warning text-white">
      <h3 class="mb-0">Editar Practicante</h3>
    </div>
    <div class="card-body">

      <form action="/practicantes/<%= practicante.id %>" method="POST">
        <!-- Para actualizar, usamos PUT -->
        <input type="hidden" name="_method" value="PUT">

        <!-- Campo para el nombre del practicante -->
        <div class="mb-3">
          <label for="nombre_completo" class="form-label">Nombre</label>
          <input type="text" class="form-control rounded-3" id="nombre_completo" name="nombre_completo" value="<%= practicante.nombre_completo %>" required>
        </div>

        <!-- Campo para el correo del practicante -->
        <div class="mb-3">
          <label for="correo" class="form-label">Correo</label>
          <input type="email" class="form-control rounded-3" id="correo" name="correo" value="<%= practicante.correo %>" required>
        </div>

        <!-- Campo para seleccionar la carrera -->
        <div class="mb-3">
          <label for="carrera" class="form-label">Carrera</label>
          <select class="form-control rounded-3" id="carrera" name="carrera_id" required>
            <% carreras.forEach(carrera => { %>
              <option value="<%= carrera.id %>" <%= carrera.id == practicante.carrera_id ? 'selected' : '' %> >
                <%= carrera.nombre %>
              </option>
            <% }) %>
          </select>
        </div>

        <!-- Campo para el teléfono del practicante -->
        <div class="mb-3">
          <label for="telefono" class="form-label">Teléfono</label>
          <input type="text" class="form-control rounded-3" id="telefono" name="telefono" value="<%= practicante.telefono %>" required>
        </div>

        <!-- Campo para la fecha de inicio -->
        <div class="mb-3">
          <label for="fecha_inicio" class="form-label">Fecha de Inicio</label>
          <input type="date" class="form-control rounded-3" id="fecha_inicio" name="fecha_inicio" value="<%= practicante.fecha_inicio.toISOString().split('T')[0] %>" required>
        </div>

        <!-- Botones -->
        <div class="d-flex justify-content-between">
          <a href="/practicantes" class="btn btn-secondary rounded-3">Cancelar</a>
          <button type="submit" class="btn btn-warning rounded-3">Actualizar</button>
        </div>
      </form>

    </div>
  </div>
</div>

<%- include('../partials/footer') %>
